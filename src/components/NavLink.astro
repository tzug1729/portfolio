---
/**
 * 先頭に ▶ を置くリンク。▶ は左の溝にぶら下げる。
 *
 * ▶ の出し分けは base.css の .marker-group / .marker-item / .marker が持つ。
 * 「まとまりの中で ▶ はいつも1つだけ」という原則をそこで一括して守る。
 * 呼び出し側は、リンクを囲む要素に .marker-group を付けること。
 *
 * 文字を周囲の行頭に揃えたいときは、まとまり側で
 * margin-left: calc(var(--marker-gutter) * -1) を掛ける。
 * その際まとまりに font-size を指定し、リンク側では指定しないこと
 * （--marker-gutter は em なので、字寸がずれると溝の幅も食い違う）。
 */
interface Props {
  href: string;
  /** 現在地。地色に --accent-red を使うのはここだけ */
  current?: boolean;
  external?: boolean;
  class?: string;
}

const { href, current = false, external = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['navlink', 'marker-item', { 'navlink--current': current }, className]}
  aria-current={current ? 'page' : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="navlink__marker marker" aria-hidden="true">▶</span><span class="navlink__label"><slot /></span>
</a>

<style>
  .navlink {
    position: relative;
    display: inline-block;
    /* 左は ▶ の溝ぶん空ける。まとまり側は同じ量を打ち消して行頭を揃える */
    padding: 0.1em 0.5em 0.1em var(--marker-gutter);
    border-radius: 3px;
    color: var(--paper);
    text-decoration: none;
    transition: background-color 120ms linear;
  }

  .navlink__marker {
    position: absolute;
    left: 0.4em;
    color: var(--gold-bright);
  }

  /* 現在地。▶ も出す */
  .navlink--current {
    background-color: var(--accent-red);
  }

  .navlink--current .marker {
    opacity: 1;
    color: var(--paper);
  }
</style>
