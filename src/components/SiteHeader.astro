---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LangSwitch from './LangSwitch.astro';
import NavLink from './NavLink.astro';
import Window from './Window.astro';
import { parsePath, useTranslations } from '../i18n/ui';
import { site } from '../site.config';

const { locale, path } = parsePath(Astro.url);
const t = useTranslations(locale);

/** 一段目のセグメントで現在地を決める */
const section = path.split('/')[0] ?? '';

/** トップ / プロフィール / 作品 の3項目。サイト名はリンクにしない */
const items = [
  { key: 'home', href: getRelativeLocaleUrl(locale, ''), current: section === '' },
  { key: 'about', href: getRelativeLocaleUrl(locale, 'about'), current: section === 'about' },
  { key: 'works', href: getRelativeLocaleUrl(locale, 'works'), current: section === 'works' },
];
---

<header class="site-header">
  <Window size="s">
    <div class="site-header__row">
      <span class="site-header__name">{site.name}</span>
      <nav class="site-header__nav" aria-label={t('a11y.mainNav')}>
        {items.map((item) => <NavLink href={item.href} current={item.current}>{t(`nav.${item.key}`)}</NavLink>)}
      </nav>
      <LangSwitch />
    </div>
  </Window>
</header>

<style>
  .site-header {
    margin-bottom: var(--space-section);
  }

  .site-header__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
  }

  .site-header__name {
    margin-right: auto;
    color: var(--gold-bright);
    letter-spacing: 0.12em;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
    font-size: var(--fs-small);
  }

  /* 360px でも破綻させない。ハンバーガーは作らない */
  @media (max-width: 30rem) {
    .site-header__name {
      flex-basis: 100%;
      margin-right: 0;
    }

    .site-header__nav {
      margin-right: auto;
    }
  }
</style>
