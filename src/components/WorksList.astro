---
import { getRelativeLocaleUrl } from 'astro:i18n';
import NavLink from './NavLink.astro';
import Window from './Window.astro';
import { parsePath, useTranslations } from '../i18n/ui';
import { getWorks } from '../lib/content';

/**
 * 薄い一覧。作品ごとにカード化せず、1枚のウィンドウの中に行として並べる。
 * 区切りは罫線ではなく余白。
 */
const { locale } = parsePath(Astro.url);
const t = useTranslations(locale);
const works = await getWorks(locale);
---

<section class="works">
  <Window size="l">
    <h1 class="works__title">{t('works.title')}</h1>

    <ol class="works__list">
      {
        works.map(({ entry }) => (
          <li class="works__item">
            <h2 class="works__name">
              <NavLink href={getRelativeLocaleUrl(locale, `works/${entry.data.slug}`)}>
                {entry.data.title}
              </NavLink>
            </h2>
            <p class="works__meta">
              <span>{entry.data.period}</span>
              <span class="works__sep" aria-hidden="true">・</span>
              <span>{t(`works.${entry.data.role}`)}</span>
            </p>
            <p class="works__tech">{entry.data.tech.join(' / ')}</p>
          </li>
        ))
      }
    </ol>
  </Window>
</section>

<style>
  .works__title {
    margin-bottom: var(--space-item);
  }

  .works__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .works__item + .works__item {
    margin-top: 1.75rem;
  }

  .works__name {
    font-size: var(--fs-body);
    letter-spacing: 0.06em;
    margin-left: calc(var(--marker-gutter) * -1);
  }

  .works__meta,
  .works__tech {
    margin-top: 0.15rem;
    font-size: var(--fs-meta);
    line-height: 1.8;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .works__sep {
    margin: 0 0.4em;
  }
</style>
